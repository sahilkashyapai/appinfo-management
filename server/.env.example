# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# Production on the company server (https://ai-connect.dev.appinfoinc.com):
#   NODE_ENV=production
#   SERVE_CLIENT=true          # this process also serves the built client/dist
#   CLIENT_ORIGIN=https://ai-connect.dev.appinfoinc.com   # used for CORS and links in emails
#   TRUST_PROXY=loopback       # the reverse proxy's address (loopback = same host)
SERVE_CLIENT=false
TRUST_PROXY=loopback

# MySQL connection used by the app (Prisma). Local dev: see the Docker command in
# the MySQL migration handover. Production: add ?sslaccept=strict&connection_limit=10
DATABASE_URL=mysql://appinfo:<password>@localhost:3306/appinfo

# MongoDB Atlas — only needed by the one-off copy script
# (npm run db:copy-from-mongo) until the MySQL cutover is signed off.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aii_celebrations?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h

# The site's public URL: CORS origin and the base of links in emails.
# Local dev: the Vite dev server. Production: https://ai-connect.dev.appinfoinc.com
CLIENT_ORIGIN=http://localhost:5173

# SMTP (used by Nodemailer to actually send birthday/anniversary/event emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=noreply@appliedinformation.in
SMTP_FROM_NAME=Applied Information India

# Seed superadmin (used only by npm run seed)
SEED_SUPERADMIN_EMAIL=superadmin@aii.in
SEED_SUPERADMIN_PASSWORD=Admin@123

# Web Push (VAPID) — generate once with: node src/scripts/generateVapidKeys.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@appliedinformation.in
